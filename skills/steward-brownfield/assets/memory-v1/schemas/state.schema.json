{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/steward-brownfield/state.schema.json",
  "title": "Brownfield Steward Control State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memory_revision",
    "active_run_id",
    "last_completed_run_id",
    "last_snapshot",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "memory_revision": { "type": "integer", "minimum": 0 },
    "active_run_id": {
      "oneOf": [
        { "$ref": "#/$defs/id" },
        { "type": "null" }
      ]
    },
    "last_completed_run_id": {
      "oneOf": [
        { "$ref": "#/$defs/id" },
        { "type": "null" }
      ]
    },
    "last_snapshot": {
      "oneOf": [
        { "$ref": "#/$defs/source_snapshot" },
        { "type": "null" }
      ]
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "actor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "repository_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "status", "source_digest", "dirty_paths"],
      "properties": {
        "repository_id": { "$ref": "#/$defs/actor" },
        "status": { "enum": ["CLEAN", "DIRTY", "MISSING", "UNVERSIONED"] },
        "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "commit": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
            { "type": "null" }
          ]
        },
        "source_tree_sha256": { "$ref": "#/$defs/sha256" },
        "working_tree_sha256": { "$ref": "#/$defs/sha256" },
        "source_digest": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "dirty_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relative_path" }
        },
        "dirty_path_sha256": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/relative_path" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{64}|MISSING)$"
          }
        },
        "remote_alias": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 512 },
            { "type": "null" }
          ]
        }
      }
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "vector_digest", "source_vector_digest"],
      "properties": {
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repository_snapshot" }
        },
        "vector_digest": { "$ref": "#/$defs/sha256" },
        "source_vector_digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
