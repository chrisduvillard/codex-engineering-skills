{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:steward-brownfield:memory-v1:contribution",
  "title": "Brownfield immutable agent contribution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contribution_id",
    "run_id",
    "agent_id",
    "task_id",
    "base_memory_revision",
    "base_knowledge_digest",
    "base_record_revisions",
    "created_at",
    "source_snapshot",
    "operations",
    "checks",
    "uncertainties",
    "risk",
    "review",
    "sensitivity_review"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contribution_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "agent_id": { "$ref": "#/$defs/actor" },
    "task_id": { "$ref": "#/$defs/actor" },
    "base_memory_revision": { "type": "integer", "minimum": 0 },
    "base_knowledge_digest": {
      "description": "Compare-and-swap digest of canonical knowledge used to prepare this proposal.",
      "$ref": "#/$defs/sha256"
    },
    "base_record_revisions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "source_snapshot": { "$ref": "#/$defs/source_snapshot" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "checks": {
      "description": "Structured summaries and digests only; never raw stdout or stderr.",
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "uncertainties": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "risk": { "enum": ["LOW", "MODERATE", "HIGH"] },
    "review": { "$ref": "#/$defs/review" },
    "sensitivity_review": { "$ref": "#/$defs/sensitivity_review" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "failed_approaches": {
      "type": "array",
      "items": { "$ref": "#/$defs/failed_approach" }
    },
    "escalations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "source_change_ref": {
      "oneOf": [
        { "$ref": "#/$defs/source_change" },
        { "type": "null" }
      ]
    },
    "proposal_digest": {
      "description": "Optional digest of the complete sanitized immutable contribution, excluding this field.",
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "actor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 128
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "repository_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "status", "source_digest", "dirty_paths"],
      "properties": {
        "repository_id": { "$ref": "#/$defs/actor" },
        "status": { "enum": ["CLEAN", "DIRTY", "MISSING", "UNVERSIONED"] },
        "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "commit": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
            { "type": "null" }
          ]
        },
        "source_tree_sha256": { "$ref": "#/$defs/sha256" },
        "working_tree_sha256": { "$ref": "#/$defs/sha256" },
        "source_digest": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "dirty_paths": { "type": "array", "items": { "$ref": "#/$defs/relative_path" } },
        "dirty_path_sha256": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/relative_path" },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{64}|MISSING)$"
          }
        },
        "remote_alias": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 512 },
            { "type": "null" }
          ]
        }
      }
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "vector_digest", "source_vector_digest"],
      "properties": {
        "repositories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/repository_snapshot" } },
        "vector_digest": { "$ref": "#/$defs/sha256" },
        "source_vector_digest": {
          "description": "Content-only digest that excludes memory-only commit movement.",
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "record_stub": {
      "description": "Complete canonical record; validate it with record.schema.json before acceptance.",
      "type": "object",
      "required": [
        "schema_version",
        "id",
        "record_type",
        "record_revision",
        "classification",
        "knowledge_status",
        "workflow_status",
        "evidence",
        "verification"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "record_type": {
          "enum": [
            "claim",
            "requirement",
            "decision",
            "question",
            "contradiction",
            "finding",
            "investigation",
            "task",
            "user-event",
            "migration"
          ]
        },
        "record_revision": { "type": "integer", "minimum": 1 },
        "classification": {
          "enum": ["FACT", "USER_REQUIREMENT", "USER_ASSERTION", "DECISION", "INFERENCE", "ASSUMPTION", "HYPOTHESIS", "UNKNOWN"]
        },
        "knowledge_status": { "enum": ["CURRENT", "STALE", "INVALIDATED", "UNCERTAIN", "HISTORICAL"] },
        "workflow_status": { "type": "string", "minLength": 1, "maxLength": 64 },
        "evidence": { "type": "array" },
        "verification": { "type": "object" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "expected_revision", "record"],
      "properties": {
        "action": { "enum": ["CREATE", "UPDATE"] },
        "expected_revision": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "record": { "$ref": "#/$defs/record_stub" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "CREATE" } }, "required": ["action"] },
          "then": {
            "properties": {
              "expected_revision": { "type": "null" },
              "record": { "properties": { "record_revision": { "const": 1 } } }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "UPDATE" } }, "required": ["action"] },
          "then": { "properties": { "expected_revision": { "type": "integer", "minimum": 1 } } }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "result"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sanitized_command": {
          "description": "Repeatable command after removal of credentials and secret values.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "result": { "enum": ["PASS", "FAIL", "SKIPPED", "INCONCLUSIVE", "STALE"] },
        "summary": { "type": "string", "maxLength": 2000 },
        "exit_code": {
          "oneOf": [
            { "type": "integer" },
            { "type": "null" }
          ]
        },
        "output_digest": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "records": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "redaction_status": { "enum": ["NOT_APPLICABLE", "REVIEWED", "REDACTED"] }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "reviewer", "evidence"],
      "properties": {
        "disposition": { "enum": ["NOT_REVIEWED", "DETERMINISTIC", "CONFIRMED", "REFUTED", "UNCERTAIN"] },
        "reviewer": {
          "oneOf": [
            { "$ref": "#/$defs/actor" },
            { "type": "null" }
          ]
        },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },
    "sensitivity_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "redactions"],
      "properties": {
        "completed": { "type": "boolean" },
        "redactions": {
          "description": "Descriptions of removed sensitive material, never the material itself.",
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "failed_approach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approach", "result", "why_rejected", "reconsider_when"],
      "properties": {
        "approach": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "result": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "why_rejected": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "reconsider_when": { "type": "string", "maxLength": 1000 }
      }
    },
    "source_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "base_revision", "result_revision", "changed_paths", "patch_digest"],
      "properties": {
        "repository_id": { "$ref": "#/$defs/actor" },
        "base_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "result_revision": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 128 },
            { "type": "null" }
          ]
        },
        "changed_paths": { "type": "array", "items": { "$ref": "#/$defs/relative_path" } },
        "patch_digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
